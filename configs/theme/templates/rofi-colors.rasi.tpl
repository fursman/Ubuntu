{{! dest: ~/.config/rofi/colors.rasi }}
/* GENERATED by desktop-theme ({{ theme_name }}). Imported by every rofi theme here. */
* {
    th-bg:        {{ background }}F0;
    th-bg-alt:    {{ dark_background }};
    th-bg-light:  {{ lighter_background }};
    th-fg:        {{ foreground }};
    th-fg-dim:    {{ muted }};
    th-accent:    {{ accent }};
    th-on-accent: {{ on_accent }};
    th-border:    {{ muted }}66;
    th-urgent:    {{ red }};
    th-active:    {{ green }};
}
