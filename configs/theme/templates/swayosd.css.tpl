{{! dest: ~/.config/swayosd/style.css }}
/* GENERATED by desktop-theme ({{ theme_name }}). swayosd reads this only at
 * start; desktop-theme restarts it. Sized for scale-1 4K panels. */
window#osd {
  border-radius: 999px;
  border: 2px solid alpha({{ muted }}, 0.35);
  background: alpha({{ background }}, 0.92);
}
window#osd #container {
  margin: 20px 28px;
}
window#osd image,
window#osd label {
  color: {{ foreground }};
  font-size: 22px;
  -gtk-icon-size: 32px;
}
window#osd progressbar:disabled,
window#osd image:disabled {
  opacity: 0.5;
}
window#osd progressbar,
window#osd segmentedprogress {
  min-height: 10px;
  min-width: 360px;
  border-radius: 999px;
  background: transparent;
  border: none;
}
window#osd trough,
window#osd segment {
  min-height: inherit;
  border-radius: inherit;
  border: none;
  background: alpha({{ foreground }}, 0.18);
}
window#osd progress,
window#osd segment.active {
  min-height: inherit;
  border-radius: inherit;
  border: none;
  background: {{ accent }};
}
window#osd segment {
  margin-left: 8px;
}
window#osd segment:first-child {
  margin-left: 0;
}
