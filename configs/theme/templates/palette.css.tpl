{{! dest: ~/.config/swaync/palette.css }}
{{! dest: ~/.config/wlogout/palette.css }}
{{! dest: ~/.config/gtklock/palette.css }}
/* ==========================================================================
 * Theme palette for every GTK-CSS surface on this desktop (waybar, swaync,
 * wlogout, gtklock). GENERATED by desktop-theme from the {{ theme_name }}
 * theme -- edit the template in ~/Ubuntu/configs/theme/templates, not this.
 *
 * GTK CSS cannot expand ~, so a copy sits beside each consumer's stylesheet,
 * which pulls it in with `@import "palette.css";`.
 *
 * Use the role names (accent, surface, ...) for anything new. The Dracula-era
 * names (purple, pink, comment, current) remain as aliases so older rules and
 * local tweaks keep working on every theme.
 * ========================================================================== */

/* -- Core ---------------------------------------------------------------- */
@define-color bg          {{ background }};
@define-color bg-alt      {{ dark_background }};   /* recessed surfaces */
@define-color bg-light    {{ lighter_background }}; /* raised surfaces, buttons */
@define-color fg          {{ foreground }};
@define-color fg-bright   {{ bright_foreground }};
@define-color muted       {{ muted }};              /* secondary text, disabled */
@define-color selection   {{ selection }};
@define-color accent      {{ accent }};
@define-color on-accent   {{ on_accent }};          /* text drawn on an accent fill */

/* -- Hues ---------------------------------------------------------------- */
@define-color red         {{ red }};
@define-color orange      {{ orange }};
@define-color yellow      {{ yellow }};
@define-color green       {{ green }};
@define-color cyan        {{ cyan }};
@define-color blue        {{ blue }};
@define-color magenta     {{ magenta }};

/* -- Aliases (Dracula names) --------------------------------------------- */
@define-color purple      @accent;
@define-color pink        @magenta;
@define-color comment     @muted;
@define-color current     @selection;

/* -- Derived surfaces ------------------------------------------------------ *
 * Bars and popovers sit over the wallpaper, so they are translucent rather
 * than solid @bg. Kept here so every surface uses the SAME translucency
 * instead of each stylesheet picking its own alpha.
 * ------------------------------------------------------------------------ */
@define-color surface        alpha(@bg, 0.82);
@define-color surface-solid  alpha(@bg, 0.97);       /* popovers, menus */
@define-color surface-hover  alpha(@selection, 0.55);
@define-color border-soft    alpha(@muted, 0.28);
@define-color shadow-soft    rgba(0, 0, 0, 0.45);
