/* Spotlight-style launcher and menu theme. Colours come from the desktop
 * theme: desktop-theme writes ~/.config/rofi/colors.rasi. */
@import "~/.config/rofi/colors.rasi"

* {
    font:   "JetBrainsMono Nerd Font 13";
    background-color:   transparent;
    text-color:         @th-fg;
    margin:     0;
    padding:    0;
    spacing:    0;
}

configuration {
    show-icons:    true;
}

window {
    background-color:   @th-bg;
    border:         2px;
    border-color:   @th-border;
    location:       center;
    width:          760;
    border-radius:  14;
}

inputbar {
    font:       "JetBrainsMono Nerd Font 18";
    padding:    14px 18px;
    spacing:    14px;
    children:   [ icon-search, prompt, entry ];
    border:         0 0 1px 0;
    border-color:   @th-border;
}

prompt {
    text-color: @th-accent;
}

icon-search {
    expand:     false;
    filename:   "search";
    size: 28px;
}

icon-search, prompt, entry, element-icon, element-text {
    vertical-align: 0.5;
}

entry {
    font:   inherit;
    placeholder         : "Search";
    placeholder-color   : @th-fg-dim;
}

message {
    background-color:   @th-bg-alt;
    border:             0 0 1px 0;
    border-color:       @th-border;
}

textbox {
    padding:    10px 22px;
    text-color: @th-fg-dim;
}

listview {
    lines:      10;
    columns:    1;
    fixed-height:   false;
    padding:    8px;
    scrollbar:  false;
}

element {
    padding:            10px 16px;
    spacing:            16px;
    border-radius:      10px;
    background-color:   transparent;
}

element normal active {
    text-color: @th-accent;
}

element selected normal, element selected active {
    background-color:   @th-accent;
    text-color:         @th-on-accent;
}

element-icon {
    size:   1.4em;
}

element-text {
    text-color: inherit;
    highlight:  bold underline;
}
