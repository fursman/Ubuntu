{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer-shell-cover-screen": true,
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "control-center-width": 560,
  "control-center-height": -1,
  "fit-to-screen": false,
  "notification-window-width": 560,
  "notification-grouping": false,
  "relative-timestamps": true,
  "text-empty": "No notifications",
  "notification-icon-size": 64,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "notification-body-max-lines": 0,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 30,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "title",
    "buttons-grid",
    "volume",
    "mpris",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Quick settings",
      "clear-all-button": true,
      "button-text": "Clear notifications"
    },
    "mpris": {
      "show-album-art": "when-available",
      "autohide": true
    },
    "notifications": {
      "vexpand": false
    },
    "buttons-grid": {
      "buttons-per-row": 6,
      "actions": [
        {
          "label": "󰖩",
          "type": "toggle",
          "command": "sh -c '~/.local/bin/quick-settings wifi set'",
          "update-command": "sh -c '~/.local/bin/quick-settings wifi state'"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "command": "sh -c '~/.local/bin/quick-settings bluetooth set'",
          "update-command": "sh -c '~/.local/bin/quick-settings bluetooth state'"
        },
        {
          "label": "󰍬",
          "type": "toggle",
          "command": "sh -c '~/.local/bin/quick-settings mic set'",
          "update-command": "sh -c '~/.local/bin/quick-settings mic state'"
        },
        {
          "label": "󰖔",
          "type": "toggle",
          "command": "sh -c '~/.local/bin/quick-settings nightlight set'",
          "update-command": "sh -c '~/.local/bin/quick-settings nightlight state'"
        },
        {
          "label": "󰅶",
          "type": "toggle",
          "command": "sh -c '~/.local/bin/quick-settings stay-awake set'",
          "update-command": "sh -c '~/.local/bin/quick-settings stay-awake state'"
        },
        {
          "label": "󰂛",
          "type": "toggle",
          "command": "sh -c '~/.local/bin/quick-settings dnd set'",
          "update-command": "sh -c '~/.local/bin/quick-settings dnd state'"
        },
        {
          "label": "󰹑",
          "command": "sh -c 'swaync-client -cp -sw >/dev/null; sleep 0.35; ~/.local/bin/capture region-clip'"
        },
        {
          "label": "󰑊",
          "command": "sh -c 'swaync-client -cp -sw >/dev/null; sleep 0.35; ~/.local/bin/screenrecord region'"
        },
        {
          "label": "󰏘",
          "command": "sh -c 'swaync-client -cp -sw >/dev/null; sleep 0.35; ~/.local/bin/desktop-menu theme'"
        },
        {
          "label": "󰸉",
          "command": "sh -c '~/.local/bin/wallpaper-cycle next'"
        },
        {
          "label": "󰌾",
          "command": "sh -c 'swaync-client -cp -sw >/dev/null; sleep 0.35; ~/.local/bin/lock-screen'"
        },
        {
          "label": "󰐥",
          "command": "sh -c 'swaync-client -cp -sw >/dev/null; sleep 0.35; ~/.local/bin/desktop-menu system'"
        }
      ]
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-label": true,
      "expand-button-label": "󰅀",
      "collapse-button-label": "󰅃",
      "empty-list-label": "Nothing playing"
    }
  }
}
