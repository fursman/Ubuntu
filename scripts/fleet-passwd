#!/bin/bash
# Change the login password of `user` on every Ubuntu machine on the LAN at
# once, over the SSH keys they already share. Run it on assistant.
#
#   fleet-passwd            check every machine, then change them all
#   fleet-passwd --check    only check: reachable, and whether sudo needs a password
#   fleet-passwd block pile only these machines (e.g. one that was off last time)
#
# Machines come from ~/.config/fleet-hosts (one per line, "name host", # for
# comments) when it exists, else the list below. The machine it runs on is
# changed locally rather than over SSH (assistant has no key for itself).
#
# Passwords are read without echo and travel only on stdin, inside the SSH
# connection: never in an argument (visible in ps), a file, or shell history.
# Every machine is checked with the current password before any is changed,
# so a typo or an unreachable machine stops it before the passwords diverge.
#
# GNOME Keyring's login keyring is changed with it where there is one, so the
# next login still unlocks it. A keyring whose password was already something
# else is left alone and named at the end; the account is changed regardless.

set -u

DEFAULT_HOSTS="
blade17    blade17.local
blade13    blade13.local
macbookpro MacBookPro14-1.local
block      block.local
pile       pile.local
r740       r740.local
assistant  assistant.local
"

SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new)

# The login keyring, through gnome-keyring's own D-Bus interface: the call
# Passwords and Keys makes, minus the dialog. It checks the old password even
# when the keyring is unlocked (an unlock call would not), so "check" (stdin:
# current password) changes it to itself, and "change" (stdin: current, new)
# changes it and then changes the new one to itself to prove it took. Nothing
# is ever locked, so apps in a logged-in session do not notice.
# Exit 3 means the keyring was not touched or not proven; never fatal.
KR_PY='
import sys
try:
    from gi.repository import Gio, GLib
except ImportError:
    print("keyring left alone: no python3-gi"); sys.exit(3)
mode = sys.argv[1]
cur = sys.stdin.readline().rstrip("\n")
new = sys.stdin.readline().rstrip("\n") if mode == "change" else ""
SVC = "/org/freedesktop/secrets"
COLL = SVC + "/collection/login"
G = "org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface"
S = "org.freedesktop.Secret.Service"
try:
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    def call(iface, method, sig, args, rtype):
        return bus.call_sync("org.freedesktop.secrets", SVC, iface, method, GLib.Variant(sig, args),
                             GLib.VariantType(rtype), 0, 15000, None).unpack()
    _, session = call(S, "OpenSession", "(sv)", ("plain", GLib.Variant("s", "")), "(vo)")
    secret = lambda pw: (session, b"", pw.encode(), "text/plain")
    change = lambda a, b: call(G, "ChangeWithMasterPassword", "(o(oayays)(oayays))",
                               (COLL, secret(a), secret(b)), "()")
    if mode == "check":
        change(cur, cur)
        print("keyring opens with it"); sys.exit(0)
    change(cur, new)
    change(new, new)
    print("keyring changed, verified")
except GLib.Error as e:
    if "Denied" in e.message:
        print("keyring has a different password, left alone")
    else:
        print("keyring left alone: " + e.message.split(": ", 1)[-1])
    sys.exit(3)
'

# Shared by the scripts below: run KR_PY on the login keyring, if any.
KEYRING='
keyring() {
    [ -f "${XDG_DATA_HOME:-$HOME/.local/share}/keyrings/login.keyring" ] || { echo "no login keyring"; return 0; }
    export DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}
    python3 -I -c "$KR_PY" "$1" 2>/dev/null
}
'

# Runs on each machine. stdin: current password, then the new one.
# Where sudo needs no password (blade13) the current one is unused.
REMOTE='
IFS= read -r cur; IFS= read -r new
me=$(id -un)
if sudo -n true 2>/dev/null; then
    printf "%s:%s\n" "$me" "$new" | sudo chpasswd || exit 1
    acct="changed"
else
    { printf "%s\n" "$cur"; printf "%s:%s\n" "$me" "$new"; } | sudo -S -p "" chpasswd 2>/dev/null || exit 1
    sudo -k
    printf "%s\n" "$new" | sudo -S -p "" -v 2>/dev/null && acct="changed, verified" || { echo "changed, but sudo rejects the new password"; exit 1; }
fi
kr=$(printf "%s\n%s\n" "$cur" "$new" | keyring change); krs=$?
echo "$acct; $kr"
[ $krs = 0 ] || exit 3
'

# Runs on each machine before anything changes. stdin: the current password.
PREFLIGHT='
IFS= read -r cur
if sudo -n true 2>/dev/null; then acct="ok (sudo needs no password)"
else
    sudo -k
    printf "%s\n" "$cur" | sudo -S -p "" -v 2>/dev/null && acct="ok" || { echo "sudo rejects the current password"; exit 1; }
fi
echo "$acct; $(printf "%s\n" "$cur" | keyring check)"
'

CHECK='sudo -n true 2>/dev/null && s="no password" || s="a password"
[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/keyrings/login.keyring" ] && k="login keyring" || k="no login keyring"
echo "reachable, sudo needs $s; $k"'

# Each script gets the keyring helper in front of it.
prelude="KR_PY=$(printf %q "$KR_PY")"$'\n'"$KEYRING"
REMOTE=$prelude$REMOTE
PREFLIGHT=$prelude$PREFLIGHT

me=$(hostname -s | tr "[:upper:]" "[:lower:]")

hosts_file=~/.config/fleet-hosts
if [ -r "$hosts_file" ]; then list=$(cat "$hosts_file"); else list=$DEFAULT_HOSTS; fi

check_only=0
want=()
for a in "$@"; do
    case $a in
        --check) check_only=1 ;;
        -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) want+=("$a") ;;
    esac
done

names=(); addrs=()
while read -r name host _; do
    [ -z "$name" ] || [ "${name:0:1}" = "#" ] && continue
    if [ ${#want[@]} -gt 0 ]; then
        hit=0; for w in "${want[@]}"; do [ "$w" = "$name" ] && hit=1; done
        [ $hit = 1 ] || continue
    fi
    names+=("$name"); addrs+=("${host:-$name}")
done <<< "$list"
[ ${#names[@]} -gt 0 ] || { echo "No machines match: ${want[*]}" >&2; exit 2; }

# run INDEX SCRIPT: the script on that machine, stdin passed through.
run() {
    local n=${names[$1]} h=${addrs[$1]}
    local short; short=$(tr "[:upper:]" "[:lower:]" <<< "${h%%.*}")
    if [ "$(tr "[:upper:]" "[:lower:]" <<< "$n")" = "$me" ] || [ "$short" = "$me" ]; then
        bash -c "$2"
    else
        ssh "${SSH_OPTS[@]}" "$h" "bash -c $(printf %q "$2")" 2>/dev/null
    fi
}

if [ $check_only = 1 ]; then
    for i in "${!names[@]}"; do
        printf "%-11s " "${names[$i]}"
        out=$(run "$i" "$CHECK" < /dev/null) && echo "$out" || echo "UNREACHABLE (${addrs[$i]})"
    done
    exit 0
fi

read -rsp "Current password: " cur; echo
read -rsp "New password: " new; echo
read -rsp "New password again: " again; echo
[ "$new" = "$again" ] || { echo "The new passwords differ; nothing changed." >&2; exit 1; }
[ -n "$new" ] || { echo "Empty password; nothing changed." >&2; exit 1; }
[ "$new" != "$cur" ] || { echo "That is the current password; nothing changed." >&2; exit 1; }

echo
echo "Checking:"
bad=()
for i in "${!names[@]}"; do
    printf "  %-11s " "${names[$i]}"
    if out=$(printf "%s\n" "$cur" | run "$i" "$PREFLIGHT"); then echo "$out"
    else echo "${out:-UNREACHABLE (${addrs[$i]})}"; bad+=("${names[$i]}"); fi
done
if [ ${#bad[@]} -gt 0 ]; then
    echo
    echo "Not changing anything: ${bad[*]} failed the check."
    echo "Leave them out by naming the rest, e.g.: fleet-passwd $(printf '%s ' "${names[@]}" | tr ' ' '\n' | grep -vxF -f <(printf '%s\n' "${bad[@]}") | tr '\n' ' ')"
    exit 1
fi

echo
echo "Changing:"
failed=(); keyrings=()
for i in "${!names[@]}"; do
    printf "  %-11s " "${names[$i]}"
    out=$(printf "%s\n%s\n" "$cur" "$new" | run "$i" "$REMOTE"); rc=$?
    case $rc in
        0) echo "$out" ;;
        3) echo "$out"; keyrings+=("${names[$i]}") ;;
        *) echo "FAILED${out:+: $out}"; failed+=("${names[$i]}") ;;
    esac
done
unset cur new again

echo
if [ ${#keyrings[@]} -gt 0 ]; then
    echo "Keyring not changed on: ${keyrings[*]} -- the next login there asks for its old password once"
    echo "(or change it in Passwords and Keys > Login > Change Password)."
fi
if [ ${#failed[@]} -gt 0 ]; then
    echo "Failed on: ${failed[*]} -- those still have the old password."
    exit 1
fi
echo "Done."
