#!/bin/bash
# Start waybar at login, and start it again whenever it crashes.
#
# waybar 0.15.0 aborts if a power_supply node disappears while the battery
# module is adding it: the inotify_add_watch failure is thrown from a worker
# thread and nothing catches it (Waybar issue #5256, fixed upstream after
# 0.15.0). pile's Bluetooth Magic Trackpad reconnects every ~30 s in bursts,
# adding and removing hid-<mac>-battery each time, so the bar vanished at
# random -- sometimes within a minute of login, which is all the first
# version of this script, retrying only early exits, could catch.
#
# A deliberate stop is left alone: a clean exit, or SIGTERM/SIGINT/SIGKILL
# from restart-waybar or pkill. Any other exit is a crash and waybar is
# started again, unless it is crashing in a loop or Hyprland has gone.
# Each exit is also sent to the journal (journalctl -t waybar-launch), which
# outlives the per-login log.
#
# waybar's module commands (swaync-client -swb, playerctl --follow, ...) are
# not killed when waybar aborts: they were reparented to init and lived on,
# one set per crash -- pile had seven idle swaync-client subscribers. The
# launcher therefore runs as its own session leader and, after every exit,
# kills whatever is still in its session apart from itself.

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/waybar"
LOG="$LOG_DIR/launch.log"
MAX_CRASHES=5    # this many crashes inside WINDOW seconds means give up
WINDOW=60

# Own session, so "everything waybar left behind" is exactly our session.
if [ "$(ps -o sid= -p $$ | tr -d ' ')" != "$$" ]; then
    exec setsid "$0" "$@"
fi

mkdir -p "$LOG_DIR"
: > "$LOG"    # one login's worth

note() {
    echo "$(date '+%F %T') $*" >> "$LOG"
    logger -t waybar-launch -- "$*"
}

# restart-waybar or a manual start got there first
if pgrep -x waybar >/dev/null; then
    note "waybar already running, not starting another"
    exit 0
fi

reap_leftovers() {
    local pid left=()
    for pid in $(pgrep -s $$); do
        [ "$pid" = "$$" ] || left+=("$pid")
    done
    [ ${#left[@]} -gt 0 ] && kill -TERM "${left[@]}" 2>/dev/null
}
trap reap_leftovers EXIT
trap 'exit 143' TERM INT HUP    # so restart-waybar's TERM still runs the EXIT trap

crashes=()
while :; do
    note "starting waybar"
    waybar >> "$LOG" 2>&1
    status=$?
    reap_leftovers
    case $status in
        0|130|137|143)
            note "waybar stopped (status $status), not restarting"
            exit 0 ;;
    esac
    note "waybar crashed (status $status)"
    if ! pgrep -x Hyprland >/dev/null; then
        note "Hyprland has gone, not restarting"
        exit 0
    fi
    now=$SECONDS
    recent=()
    for t in "${crashes[@]}"; do
        (( now - t < WINDOW )) && recent+=("$t")
    done
    crashes=("${recent[@]}" "$now")
    if (( ${#crashes[@]} >= MAX_CRASHES )); then
        note "giving up: $MAX_CRASHES crashes within ${WINDOW}s"
        exit 1
    fi
    sleep "${#crashes[@]}"
done
