#!/usr/bin/env bash
# Step through wallpapers: wallpaper-cycle next|prev
#
# The pool is the current theme's own wallpapers when it ships some
# (desktop-theme wallpapers), otherwise every image under ~/Pictures/Wallpapers.
# Position comes from the wallpaper actually on screen, so it stays right after
# a theme switch or a pick from the wallpaper menu.

export PATH="$HOME/.local/bin:$PATH"
WALLPAPER_DIR="$HOME/Pictures/Wallpapers"
CURRENT="${XDG_STATE_HOME:-$HOME/.local/state}/desktop-theme/wallpaper"

mapfile -t images < <(desktop-theme wallpapers 2>/dev/null)
if [ ${#images[@]} -eq 0 ]; then
    mapfile -t images < <(find "$WALLPAPER_DIR" -type f \( -iname '*.jpg' -o -iname '*.jpeg' \
        -o -iname '*.png' -o -iname '*.gif' -o -iname '*.webp' \) ! -name 'current.*' | sort)
fi
[ ${#images[@]} -eq 0 ] && exit 1

now="$(readlink -f "$CURRENT" 2>/dev/null)"
index=-1
for i in "${!images[@]}"; do
    [ "$(readlink -f "${images[$i]}")" = "$now" ] && { index=$i; break; }
done

case "${1:-next}" in
    next) index=$(( (index + 1) % ${#images[@]} )) ;;
    prev) index=$(( (index - 1 + ${#images[@]}) % ${#images[@]} )) ;;
esac

wallpaper-set "${images[$index]}"
notify-send -a wallpaper -u low -t 2000 -i preferences-desktop-wallpaper \
    "Wallpaper $((index + 1))/${#images[@]}" "$(basename "${images[$index]}")"
