#!/bin/bash
# Gracefully restart waybar with correct Hyprland environment

HYPR_PID=$(pgrep -x Hyprland)
if [ -z "$HYPR_PID" ]; then
    echo "Hyprland not running"
    exit 1
fi

SRC_PID=$(pgrep -x waybar || echo "$HYPR_PID")
SRC_PID=$(echo "$SRC_PID" | head -1)
export $(cat /proc/$SRC_PID/environ 2>/dev/null | tr '\0' '\n' | grep -E "^(WAYLAND_DISPLAY|XDG_RUNTIME_DIR|HYPRLAND_INSTANCE_SIGNATURE|DISPLAY|MOZ_ENABLE_WAYLAND|QT_WAYLAND_DISABLE_WINDOWDECORATION)=")

LATEST_SIG=$(ls -t /run/user/1000/hypr/ 2>/dev/null | head -1)
if [ -n "$LATEST_SIG" ]; then
    export HYPRLAND_INSTANCE_SIGNATURE="$LATEST_SIG"
fi

# With no waybar left to copy from, the environ above is Hyprland's own, which
# never holds WAYLAND_DISPLAY (Hyprland sets it after it starts). Find the
# compositor's socket instead, or the new bar dies with "cannot open display".
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "$WAYLAND_DISPLAY" ]; then
    # Exactly wayland-N: awww-daemon puts wayland-1-awww-daemon.sock alongside.
    SOCK=$(ls -t "$XDG_RUNTIME_DIR" 2>/dev/null | grep -xE 'wayland-[0-9]+' | head -1)
    [ -n "$SOCK" ] && export WAYLAND_DISPLAY="$SOCK"
fi

# -x: an unanchored "waybar" pattern also matches this script's own name, and
# killed it before it could start the new bar.
pkill -TERM -x waybar-launch 2>/dev/null
pkill -TERM -x waybar 2>/dev/null
sleep 0.5
pkill -9 -x waybar 2>/dev/null
sleep 0.3
# Through the launcher, so the new bar is restarted if it crashes too.
setsid -f "$HOME/.local/bin/waybar-launch" >/dev/null 2>&1 < /dev/null
sleep 0.5
echo "Waybar restarted (pid $(pgrep -x waybar))"
